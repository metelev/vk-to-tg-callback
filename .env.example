# One service instance maps one VK community to one Telegram channel.
VK_GROUP_ID=157689028
VK_CALLBACK_SECRET=replace-with-random-secret
VK_CONFIRMATION=replace-with-code-from-vk
VK_USER_TOKEN=replace-with-vk-user-token-with-video-access
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=-1001234567890
# Leave blank when Telegram is reachable directly.
TELEGRAM_PROXY_URL=

CALLBACK_PATH=/vk/callback
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
DATABASE_PATH=data/state.sqlite3
MEDIA_LIMIT_MB=49
